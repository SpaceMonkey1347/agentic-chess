{
  "name": "agentic-chess",
  "version": "1.0.0",
  "description": "",
  "main": "src/server/server.js",
  "type": "module",
  "scripts": {
    "dev:sync": "concurrently \"pnpm run dev:build\" \"pnpm run dev:server\" \"pnpm run dev:bs\"",
    "dev:bs": "browser-sync start --proxy 'localhost:3000' --files 'src/public/**/*,dist/**/*' --no-open --listen localhost",
    "dev:server": "node --watch --watch-preserve-output src/server/server.js",
    "dev:build": "node esbuild.mjs --watch",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0",
  "packageManager": "pnpm@10.33.0",
  "dependencies": {
    "@lichess-org/chessground": "^10.5.0",
    "chess.js": "^1.4.0",
    "express": "^5.3.0",
    "htmx.org": "2.0.11",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "browser-sync": "^3.0.4",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "typescript": "^7.0.2"
  }
}
